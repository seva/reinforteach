{
  "id": "reinforteach",
  "name": "Reinforteach",
  "version": "0.1.0",
  "description": "Converts operator feedback on agent turns into DPO training signal for local models",
  "kind": "enforcement",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "adaptive_learning": {
        "type": "object",
        "description": "Training pipeline configuration",
        "properties": {
          "feedback_window_turns": { "type": "number" },
          "confidence_threshold": { "type": "number" },
          "training_trigger": {
            "type": "object",
            "properties": {
              "min_candidates": { "type": "number" },
              "max_interval": { "type": "string" }
            }
          },
          "model_path": { "type": "string" },
          "oracle_subagent": { "type": "string" }
        }
      }
    },
    "required": []
  }
}
